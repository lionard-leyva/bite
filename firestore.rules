rules_version = '2';
// Reglas propuestas para Bite. Se prueban con `npm run test:emulator`.
// NO estan desplegadas: publicarlas en la consola de Firebase es decision de lio.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lists/$(listId))
        && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
    }

    // Perfil propio; el de otro solo si comparte lista con quien lee.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId
          || (resource != null
              && resource.data.get('sharedListId', null) != null
              && isMember(resource.data.sharedListId)));
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /lists/{listId} {
      // Unirse con codigo necesita consultar por inviteCode antes de ser miembro.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        // miembros: cualquier cambio salvo cambiar de dueno
        (request.auth.uid in resource.data.members
          && request.resource.data.ownerId == resource.data.ownerId)
        // no miembro: solo anadirse a si mismo
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members));
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    match /restaurants/{restaurantId} {
      allow read: if isMember(resource.data.listId);
      allow create: if isMember(request.resource.data.listId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(resource.data.listId)
        && isMember(request.resource.data.listId);
      allow delete: if isMember(resource.data.listId);
    }

    match /decisionSessions/{listId} {
      allow read, write: if isMember(listId);
    }

    // id = {roundId}_{userId}: cada uno escribe solo sus votos.
    match /decisionVotes/{voteId} {
      // subscribeVotes filtra por listId, requisito para que esta regla acepte la query.
      allow read: if isMember(resource.data.listId);
      allow create, update: if isMember(request.resource.data.listId)
        && request.resource.data.userId == request.auth.uid
        && voteId == request.resource.data.roundId + '_' + request.auth.uid;
    }
  }
}
