{
  "name": "bite",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "server:dev": "cd server && node --watch index.js",
    "server:test": "cd server && npm test",
    "typecheck": "tsc --noEmit",
    "qa:map": "node scripts/qa/map-callout.js",
    "qa:location": "node scripts/qa/location.js",
    "qa:logs": "node scripts/qa/logs.js"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "**/searchFilter.test.ts",
          "**/timeAgo.test.ts",
          "**/matchLogic.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": "babel-jest"
        }
      },
      {
        "displayName": "components",
        "preset": "jest-expo/ios",
        "testMatch": [
          "**/*.test.tsx"
        ],
        "moduleNameMapper": {
          "@expo/vector-icons": "<rootDir>/jest/__mocks__/@expo/vector-icons.js"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|nativewind|react-native-map-clustering)"
        ]
      }
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.9.0",
    "nativewind": "^4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
