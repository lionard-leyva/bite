{
  "name": "bite",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --selectProjects unit components",
    "test:watch": "jest --watch --selectProjects unit components",
    "server:dev": "cd server && node --watch index.js",
    "server:test": "cd server && npm test",
    "typecheck": "tsc --noEmit",
    "qa:map": "node scripts/qa/map-callout.js",
    "qa:location": "node scripts/qa/location.js",
    "qa:logs": "node scripts/qa/logs.js",
    "qa:share": "node scripts/qa/share.js",
    "qa:all": "node scripts/qa/all.js",
    "qa:seed": "node scripts/qa/seed.js",
    "qa:save": "node scripts/qa/save.js",
    "qa:list": "node scripts/qa/list.js",
    "qa:detail": "node scripts/qa/detail.js",
    "qa:keyboard": "node scripts/qa/keyboard.js",
    "qa:safearea": "node scripts/qa/safearea.js",
    "qa:empty": "node scripts/qa/empty.js",
    "qa:map-controls": "node scripts/qa/map-controls.js",
    "qa:profile": "node scripts/qa/profile.js",
    "sync": "node scripts/sync.js",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-bite \"jest --selectProjects emulator --runInBand\""
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": [
          "**/searchFilter.test.ts",
          "**/timeAgo.test.ts",
          "**/matchLogic.test.ts",
          "**/shareParser.test.ts",
          "**/listService.test.ts",
          "**/decisionService.test.ts",
          "**/qaSeed.test.ts",
          "**/keyboardOverlap.test.ts",
          "**/safeAreaOffenders.test.ts",
          "**/*.feature.test.ts",
          "**/featureLinks.test.ts",
          "**/screenSummary.test.ts",
          "**/qaReveal.test.ts",
          "**/qaPermissions.test.ts",
          "**/qaScripts.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": "babel-jest"
        }
      },
      {
        "displayName": "components",
        "preset": "jest-expo/ios",
        "testMatch": [
          "**/*.test.tsx"
        ],
        "moduleNameMapper": {
          "@expo/vector-icons": "<rootDir>/jest/__mocks__/@expo/vector-icons.js"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|nativewind|react-native-map-clustering|@cucumber/.*|jest-cucumber|uuid)"
        ]
      },
      {
        "displayName": "emulator",
        "testEnvironment": "node",
        "testMatch": [
          "**/*.emulator.test.ts"
        ],
        "transform": {
          "\\.[jt]sx?$": "babel-jest"
        }
      }
    ]
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/young-serif": "^0.4.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.13.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.12.0",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "firebase": "^12.9.0",
    "nativewind": "^4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-places-autocomplete": "^2.6.4",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "firebase-tools": "^15.32.1",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "jest-expo": "~57.0.5",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
